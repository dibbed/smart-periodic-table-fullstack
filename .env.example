# =============================================================================
# Smart Periodic Table - Environment Configuration Template
# =============================================================================
# Copy this template to `.env` in the repository root for local development:
#   cp .env.example .env
# =============================================================================

# HTTP Port for Express backend server
PORT=3000

# Server host interface binding (127.0.0.1 for local dev, 0.0.0.0 for Docker/PaaS)
HOST=127.0.0.1

# Application environment runtime mode (development | production | test)
NODE_ENV=development

# Allowed client origin for CORS policies (single, comma-separated list, or * for all):
# Examples:
#   CLIENT_URL=http://localhost:5173
#   CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
#   CLIENT_URL=*
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Optional custom SQLite database path (defaults to data/periodic_table.db)
# DB_PATH=data/periodic_table.db

# Optional custom seed JSON file path (defaults to data/elements.json)
# SEED_PATH=data/elements.json
