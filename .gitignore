# =============================================================================
# Standard .gitignore for Node.js + SQLite Full-Stack Project
# =============================================================================

# --- SQLite Database Files & WAL / Journal Artifacts ---
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3

# Explicitly retain canonical scientific seed and schema definitions inside data/
!data/*.json
!data/*.sql

# --- Node.js Dependencies & Package Managers ---
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js

# --- Logs & Process Artifacts ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# --- Runtime Data, PIDs, and Diagnostic Reports ---
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Caching & Temporary Directories ---
.cache/
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache/
.turbo/
*.tsbuildinfo
.npm/

# --- Build Outputs & Bundles ---
dist/
dist/*
build/
out/
.next/
.nuxt/
.output/

# --- Environment Variables & Sensitive Credentials ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template

# --- Testing & Code Coverage ---
coverage/
.nyc_output/

# --- IDE & Editor Configuration ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# --- OS System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
